{%- endmacro -%}

{%- macro anchor(repo) -%}
{{ repo.split('/')[-1] | lower | regex_replace('[^a-z0-9 _-]', '') | replace(' ', '-') }}
{%- endmacro -%}

{%- macro short_id(image_id) -%}
